PORT=4000
# Mode base de données :
# - local (défaut en local via PGlite .pgdata)
# - firestore (Cloud Firestore sur Firebase — automatique sur Cloud Functions)
# DB_MODE=firestore
# FIREBASE_PROJECT_ID=crm-rayons
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
# Mode PostgreSQL local / externe :
DATABASE_URL=postgres://crm:crm@localhost:5432/crm
JWT_SECRET=change-me-long-random
PUBLIC_URL=https://crm-rayons.web.app
# Verification token du webhook WhatsApp (Meta)
WHATSAPP_VERIFY_TOKEN=change-me
